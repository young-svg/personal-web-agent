# Required for P0-B smoke. Fill only in your private .env; never commit a key.
DEEPSEEK_API_KEY=
# Disable anonymous browser-use telemetry.
ANONYMIZED_TELEMETRY=false
BROWSER_USE_CLOUD_SYNC=false
BROWSER_USE_DISABLE_EXTENSIONS=1
# Keep browser-use configuration and generated data private and project-local.
BROWSER_USE_CONFIG_DIR=.local/browser-use
